<?xml version="1.0"?>
<launch>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="input/pointcloud" default="/sensing/lidar/concatenated/pointcloud"/>
  <arg name="obstacle_segmentation_ground_segmentation_param_path"/>
  <arg name="object_recognition_detection_voxel_grid_based_euclidean_cluster_param_path"/>
  <arg name="use_low_height_cropbox" default="false"/>

  <group>
    <push-ros-namespace namespace="perception"/>

    <group>
      <push-ros-namespace namespace="obstacle_segmentation"/>
      <include file="$(find-pkg-share tier4_perception_launch)/launch/obstacle_segmentation/ground_segmentation/ground_segmentation.launch.py">
        <arg name="base_frame" value="base_link"/>
        <arg name="use_intra_process" value="true"/>
        <arg name="use_multithread" value="true"/>
        <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
        <arg name="input/pointcloud" value="$(var input/pointcloud)"/>
        <arg
          name="obstacle_segmentation_ground_segmentation_param_path"
          value="$(var obstacle_segmentation_ground_segmentation_param_path)"
        />
        <arg name="use_single_frame_filter" value="false"/>
        <arg name="use_time_series_filter" value="false"/>
        <arg name="use_cuda_ground_segmentation" value="false"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="object_recognition"/>
      <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/detection/detector/lidar_rule_detector.launch.xml">
        <arg name="ns" value="/perception/object_recognition/detection"/>
        <arg name="node/pointcloud_container" value="$(var pointcloud_container_name)"/>
        <arg name="input/pointcloud_map/pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
        <arg name="input/obstacle_segmentation/pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
        <arg
          name="output/cluster_objects"
          value="/perception/object_recognition/detection/clustering/objects_with_feature"
        />
        <arg name="output/objects" value="/perception/object_recognition/detection/objects"/>
        <arg
          name="voxel_grid_based_euclidean_param_path"
          value="$(var object_recognition_detection_voxel_grid_based_euclidean_cluster_param_path)"
        />
        <arg name="use_low_height_cropbox" value="$(var use_low_height_cropbox)"/>
      </include>
    </group>
  </group>
</launch>
